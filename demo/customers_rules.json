{
  "version": 1,
  "name": "customers",
  "allow_extra_columns": true,
  "check_duplicate_rows": true,
  "fields": {
    "customer_id":   { "type": "integer", "required": true, "unique": true },
    "customer_code": { "type": "string",  "required": true, "pattern": { "regex": "^CUS-[0-9]{4}$" } },
    "full_name":     { "type": "string",  "required": true, "min_length": 2, "max_length": 60 },
    "email":         { "type": "string",  "required": true, "unique": true, "pattern": "email" },
    "phone":         { "type": "string",  "pattern": "phone" },
    "age":           { "type": "integer", "min": 18, "max": 120 },
    "plan":          { "type": "string",  "required": true, "allowed": ["free", "pro", "enterprise"] },
    "is_active":     { "type": "boolean", "required": true },
    "signup_date":   { "type": "date",    "required": true, "format": "YYYY-MM-DD", "min": "2020-01-01", "max": "2026-12-31" },
    "website":       { "type": "string",  "pattern": "url" }
  }
}
