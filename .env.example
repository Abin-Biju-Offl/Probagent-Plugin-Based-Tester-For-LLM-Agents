# Copy to .env and fill in values. Never commit .env.
# Probagent does not load .env automatically; export these in your shell
# (or use a tool like direnv / python-dotenv).

# Folder where run logs (runs.jsonl) are written. Defaults to ./.probagent
PROBAGENT_LOG_DIR=.probagent

# Bearer token for agent endpoints that require auth (referenced as ${AGENT_TOKEN} in configs)
AGENT_TOKEN=
